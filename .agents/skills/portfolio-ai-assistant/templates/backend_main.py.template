import logging
import os
import time
from typing import Dict, List
from fastapi import FastAPI, HTTPException, Request, status
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field
import httpx
from dotenv import load_dotenv

from knowledge import SYSTEM_PROMPT

# Setup logging (suppress httpx info to prevent header/URL leaks)
logger = logging.getLogger("portfolio_ai")
if not logger.handlers:
    logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(name)s: %(message)s")
logging.getLogger("httpx").setLevel(logging.WARNING)

# Timeout settings (30s read, 6s connect)
TIMEOUT = httpx.Timeout(30.0, connect=6.0)

load_dotenv()

app = FastAPI(
    title="Portfolio Assistant API",
    description="Backend service for portfolio AI assistant",
    version="1.0.0"
)

# CORS Configuration
raw_origins = os.getenv(
    "ALLOWED_ORIGINS",
    "http://localhost:3000,http://127.0.0.1:8000,https://YOUR_GITHUB_USERNAME.github.io"
)
allowed_origins = [origin.strip() for origin in raw_origins.split(",") if origin.strip()]

app.add_middleware(
    CORSMiddleware,
    allow_origins=allowed_origins,
    allow_credentials=True,
    allow_methods=["GET", "POST", "OPTIONS"],
    allow_headers=["*"],
)

# In-Memory Rate Limiting (10 req/min per IP)
RATE_LIMIT_PER_MINUTE = int(os.getenv("RATE_LIMIT_PER_MINUTE", "10"))
ip_request_history: Dict[str, List[float]] = {}

def check_rate_limit(client_ip: str):
    now = time.time()
    timestamps = ip_request_history.get(client_ip, [])
    valid_timestamps = [ts for ts in timestamps if now - ts < 60]
    
    if len(valid_timestamps) >= RATE_LIMIT_PER_MINUTE:
        raise HTTPException(
            status_code=status.HTTP_429_TOO_MANY_REQUESTS,
            detail="Rate limit exceeded. Please wait a minute before asking another question."
        )
    
    valid_timestamps.append(now)
    ip_request_history[client_ip] = valid_timestamps

class ChatRequest(BaseModel):
    message: str = Field(..., min_length=1, max_length=500, description="Visitor's question")

class ChatResponse(BaseModel):
    answer: str

async def query_gemini(user_message: str, api_key: str) -> str:
    model = os.getenv("GEMINI_MODEL", "gemini-3.5-flash-lite")
    url = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent"
    headers = {
        "x-goog-api-key": api_key,
        "Content-Type": "application/json"
    }
    
    payload = {
        "system_instruction": {"parts": [{"text": SYSTEM_PROMPT}]},
        "contents": [{"role": "user", "parts": [{"text": user_message}]}],
        "generationConfig": {"temperature": 0.2, "maxOutputTokens": 700}
    }
    
    max_attempts = 2
    for attempt in range(1, max_attempts + 1):
        try:
            async with httpx.AsyncClient(timeout=TIMEOUT) as client:
                response = await client.post(url, headers=headers, json=payload)
                response.raise_for_status()
                data = response.json()
                
                candidates = data.get("candidates", [])
                if not candidates:
                    return "I apologize, but I could not parse the response from the AI model."
                parts = candidates[0].get("content", {}).get("parts", [])
                if not parts:
                    return "I apologize, but I received an empty response from the AI model."
                return parts[0].get("text", "").strip()

        except (httpx.ReadTimeout, httpx.ConnectTimeout, httpx.TimeoutException) as exc:
            logger.warning(f"Gemini timeout on attempt {attempt}/{max_attempts}: {type(exc).__name__}")
            if attempt < max_attempts:
                continue
            return "The AI service is currently experiencing high latency. Please try again."

        except httpx.HTTPStatusError as exc:
            status_code = exc.response.status_code if exc.response is not None else "unknown"
            detail = exc.response.text if exc.response is not None else ""
            logger.error(f"Gemini HTTPStatusError: status_code={status_code}, detail={detail}")
            return f"The AI service returned an error (HTTP {status_code}). Please try again later."

        except Exception as exc:
            logger.error(f"Unexpected error in query_gemini: {type(exc).__name__}")
            return "An unexpected error occurred while generating the response."

    return "The AI service took too long to respond. Please try again."

async def query_openai(user_message: str, api_key: str) -> str:
    model = os.getenv("OPENAI_MODEL", "gpt-4o-mini")
    url = "https://api.openai.com/v1/chat/completions"
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json"
    }
    payload = {
        "model": model,
        "temperature": 0.2,
        "max_tokens": 700,
        "messages": [
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": user_message}
        ]
    }
    
    max_attempts = 2
    for attempt in range(1, max_attempts + 1):
        try:
            async with httpx.AsyncClient(timeout=TIMEOUT) as client:
                response = await client.post(url, headers=headers, json=payload)
                response.raise_for_status()
                data = response.json()
                choices = data.get("choices", [])
                if not choices:
                    return "I apologize, but I could not parse the response from the AI model."
                return choices[0].get("message", {}).get("content", "").strip()

        except (httpx.ReadTimeout, httpx.ConnectTimeout, httpx.TimeoutException) as exc:
            logger.warning(f"OpenAI timeout on attempt {attempt}/{max_attempts}: {type(exc).__name__}")
            if attempt < max_attempts:
                continue
            return "The AI service is currently experiencing high latency. Please try again."

        except httpx.HTTPStatusError as exc:
            status_code = exc.response.status_code if exc.response is not None else "unknown"
            logger.error(f"OpenAI HTTPStatusError: status_code={status_code}")
            return f"The AI service returned an error (HTTP {status_code}). Please try again later."

        except Exception as exc:
            logger.error(f"Unexpected error in query_openai: {type(exc).__name__}")
            return "An unexpected error occurred while generating the response."

    return "The AI service took too long to respond. Please try again."

@app.get("/health")
async def health():
    has_gemini = bool(os.getenv("GEMINI_API_KEY"))
    has_openai = bool(os.getenv("OPENAI_API_KEY"))
    return {
        "status": "ok",
        "service": "Portfolio AI Backend",
        "llm_configured": has_gemini or has_openai,
        "active_provider": "gemini" if has_gemini else ("openai" if has_openai else "none")
    }

@app.post("/chat", response_model=ChatResponse)
async def chat(request: Request, payload: ChatRequest):
    user_msg = payload.message.strip()
    if not user_msg:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail="Question cannot be blank.")

    client_ip = request.client.host if request.client else "unknown"
    check_rate_limit(client_ip)

    gemini_key = os.getenv("GEMINI_API_KEY", "").strip()
    openai_key = os.getenv("OPENAI_API_KEY", "").strip()
    preferred_provider = os.getenv("LLM_PROVIDER", "gemini").lower()

    if preferred_provider == "openai" and openai_key:
        answer = await query_openai(user_msg, openai_key)
    elif gemini_key:
        answer = await query_gemini(user_msg, gemini_key)
    elif openai_key:
        answer = await query_openai(user_msg, openai_key)
    else:
        answer = "Backend is running, but no LLM API key has been configured yet."

    return ChatResponse(answer=answer)
