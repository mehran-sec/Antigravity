Customize the profile variables for each candidate/project.
"""

USER_NAME = "{{USER_NAME}}"
ASSISTANT_NAME = "{{ASSISTANT_NAME}}"

USER_PROFILE = """
=== ABOUT {{USER_NAME}} ===
- Full Name: {{USER_NAME}}
- Title: {{ROLE_TITLE}}
- Summary: {{BIO_SUMMARY}}
- Location: {{LOCATION}}
- Availability: {{AVAILABILITY}}
- Direction / Career Goals: {{CAREER_DIRECTION}}

=== EDUCATION ===
- Degree: {{DEGREE}}
